# ==============================================================================
# VARIABLES DE ENTORNO DE FUSION SOLAR (DEVSECOPS / ISO 27001)
# ==============================================================================

# Configuración de Base de Datos PostgreSQL en Neon (Serverless) con SSL forzado
# Endpoint con pooler (recomendado para peticiones regulares):
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-curly-frog-a5itruv5-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Endpoint directo sin pooler (recomendado para migraciones DDL y backups con pg_dump/pg_restore):
DIRECT_DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-curly-frog-a5itruv5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Configuración Criptográfica y de Ejecución de Django
# Generar una clave de al menos 50 caracteres aleatorios en producción
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion-minimo-50-caracteres
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.fusionsolar.local

# Seguridad HTTP, SSL y HSTS (RFC 6797)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Control de Origen de Recursos Cruzados (CORS) y Confianza CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parámetros del Servicio de Correo Electrónico Seguro (SMTP TLS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=fsolar2025@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-aqui-sin-comillas
DEFAULT_FROM_EMAIL=fsolar2025@gmail.com

# Configuración y Retención de Backups (Política 3-2-1)
BACKUPS_DIR=backups
BACKUP_RETENTION_FULL=4
BACKUP_RETENTION_INCREMENTAL=7
BACKUP_RETENTION_DIFFERENTIAL=4

# Credenciales de Administrador para Inicialización Segura
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fusionsolar.local
ADMIN_PASSWORD=GenerarPasswordSeguro14Caract!
